{
  "realm": "ecom",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Bank staff"
      },
      {
        "name": "partner",
        "description": "A merchant with a verified email"
      },
      {
        "name": "merchant",
        "description": "A merchant's server (API client): creates payments"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-ecom",
        "description": "Every user and API client: offline access and the ecom-api audience",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "ecom-api": [
              "caller"
            ]
          }
        }
      }
    ],
    "client": {
      "ecom-api": [
        {
          "name": "caller",
          "description": "Puts ecom-api in the token's audience (Keycloak's audience resolve)"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-ecom"
  },
  "clients": [
    {
      "clientId": "ecom-api",
      "name": "The ecom API, the audience every token names",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "ecom-backend",
      "name": "ecom backend",
      "enabled": true,
      "publicClient": false,
      "secret": "local-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "ecom-portal",
      "name": "Merchant and admin portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5180/*"
      ],
      "webOrigins": [
        "http://localhost:5180"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5180/*",
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:5180",
      "baseUrl": "/"
    }
  ],
  "users": [
    {
      "username": "aziz",
      "enabled": true,
      "email": "aziz@heeypay.uz",
      "emailVerified": true,
      "firstName": "Aziz",
      "credentials": [
        {
          "type": "password",
          "value": "local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "default-roles-ecom"
      ]
    },
    {
      "username": "malika",
      "enabled": true,
      "email": "malika@heeypay.uz",
      "emailVerified": true,
      "firstName": "Malika",
      "credentials": [
        {
          "type": "password",
          "value": "local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "default-roles-ecom"
      ]
    },
    {
      "username": "service-account-ecom-backend",
      "enabled": true,
      "serviceAccountClientId": "ecom-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-clients",
          "view-clients",
          "view-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"validations\": {\"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}]}"
          ]
        }
      }
    ]
  },
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ru",
    "uz"
  ],
  "defaultLocale": "en",
  "loginTheme": "ecom",
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@heeypay.uz",
    "fromDisplayName": "HeeyPay"
  }
}
