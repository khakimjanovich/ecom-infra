# Run any ecom service with the OpenTelemetry Java agent: traces, metrics and logs go to the
# observability service over OTLP. Locally, from a service's folder:
#   set -a; . ../ecom-infra/observability/agent.env; set +a
#   OTEL_SERVICE_NAME=ecom ./gradlew :app:bootRun
# (adapters: uzcard-adapter, humo-adapter; the file service: file-service)
JAVA_TOOL_OPTIONS=-javaagent:../ecom-infra/observability/agent/opentelemetry-javaagent.jar
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# Every trace locally; production samples (e.g. parentbased_traceidratio with OTEL_TRACES_SAMPLER_ARG=0.1).
OTEL_TRACES_SAMPLER=parentbased_always_on
# The app's own Micrometer meters (payments by outcome, scheme latency) go out with the rest.
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true
OTEL_METRIC_EXPORT_INTERVAL=10000
